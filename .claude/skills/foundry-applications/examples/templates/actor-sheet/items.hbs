{{!-- Part "items" (a tab). data-item-id enables the built-in ActorSheetV2 drag & drop. --}}
<section class="tab {{tab.cssClass}}" data-group="sheet" data-tab="items">
  <ol class="item-list">
    {{#each items}}
    <li class="item" data-item-id="{{id}}">
      <img src="{{img}}" alt="" width="24" height="24">
      <a data-action="openItem">{{name}}</a>
      {{#if @root.editable}}
      <button type="button" data-action="deleteItem" aria-label="{{localize 'my-module.Sheet.DeleteItem'}}">
        <i class="fa-solid fa-trash"></i>
      </button>
      {{/if}}
    </li>
    {{else}}
    <li class="empty">{{localize "my-module.Sheet.NoItems"}}</li>
    {{/each}}
  </ol>
</section>
