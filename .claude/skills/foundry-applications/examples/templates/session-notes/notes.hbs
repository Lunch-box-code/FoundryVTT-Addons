{{!-- Part "notes". One top-level element. Tab parts need class "tab", data-group, data-tab. --}}
<section class="tab {{tab.cssClass}}" data-group="primary" data-tab="notes">
  <div class="form-group stacked">
    <label>{{localize "my-module.SessionNotes.Notes"}}</label>
    <textarea name="notes" rows="12">{{notes}}</textarea>
    <p class="hint"><span class="char-count">{{notes.length}}</span> characters</p>
  </div>
</section>
