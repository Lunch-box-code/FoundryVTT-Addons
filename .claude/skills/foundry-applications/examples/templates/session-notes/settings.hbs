{{!-- Part "settings". --}}
<section class="tab {{tab.cssClass}}" data-group="primary" data-tab="settings">
  <div class="form-group">
    <label>{{localize "my-module.SessionNotes.Mood"}}</label>
    <div class="form-fields">
      <select name="mood">
        {{selectOptions moods selected=mood localize=true}}
      </select>
      {{!-- type="button" is required, otherwise the button submits the form --}}
      <button type="button" data-action="rollMood">
        <i class="fa-solid fa-dice"></i>
      </button>
    </div>
  </div>
</section>
